# ============================================================
# Koneksi SQL Server 2025 di VPS
# Untuk development lokal, isi HOST dengan 'localhost' karena
# koneksi dilakukan lewat SSH tunnel (lihat CLAUDE.md):
#   ssh -L 1433:localhost:1433 inventoryrpg@103.59.94.43
# ============================================================
DB_HOST="localhost"
DB_PORT=1433
DB_NAME="InventoryGudang"
DB_USER="sa"
# JANGAN pakai nilai contoh ini apa adanya — generate sendiri, mis: openssl rand -base64 24
DB_PASSWORD="__WAJIB_GANTI_JANGAN_DIPAKAI_LANGSUNG__"
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ============================================================
# JWT — untuk auth. JANGAN pakai nilai contoh ini apa adanya — generate sendiri,
# mis: openssl rand -base64 48. Dev dan production WAJIB beda nilai.
# ============================================================
JWT_SECRET="__WAJIB_GANTI_JANGAN_DIPAKAI_LANGSUNG__"

# ============================================================
# AI Router — self-hosted OpenAI-compatible gateway untuk fitur
# AI chatbot gudang (endpoint /api/chat-gudang).
# Di production (di VPS yang sama dengan router): pakai localhost.
# Di dev (Mac, router jalan di VPS): butuh SSH tunnel dulu, sama pola
# dengan tunnel DB: ssh -L 20128:localhost:20128 inventoryrpg@103.59.94.43
# JANGAN expose port router ini ke publik (sama seperti port 1433).
# ============================================================
AI_ROUTER_BASE_URL="http://localhost:20128/v1"
AI_ROUTER_API_KEY="isi_dengan_api_key_router_kamu"
AI_ROUTER_MODELS="cc/claude-haiku-4-5-20251001,ag/gemini-3.6-flash-medium"

# ============================================================
# Path upload foto katalog (lihat CLAUDE.md — path-based, bukan blob)
# ============================================================
UPLOAD_DIR="./uploads/foto-barang"

# Port API lokal
PORT=3000
